# =======================================================
# Campus Connect - Environment Configuration Template
# Copy this file to .env and configure for your environment
# =======================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration (Local / XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_connect
DB_PORT=3306

# Cloud Deployment (e.g., Railway / Render / Clever Cloud)
# If your cloud provider gives a connection URL, you can use:
# DATABASE_URL=mysql://user:password@host:port/campus_connect

# Session & Security
SESSION_SECRET=change_this_to_a_secure_random_string
